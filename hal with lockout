#include "main.h"

#define PASSWORD_LENGTH 4
#define MAX_ATTEMPTS 3
#define LOCKOUT_TIME 10000

const char correct_password[PASSWORD_LENGTH + 1] = "1234";

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* Set all rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Set current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait for key release */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


uint8_t CheckPassword(void)
{
    char entered_password[PASSWORD_LENGTH + 1];
    char key;
    uint8_t index;

    index = 0;

    while (index < PASSWORD_LENGTH)
    {
        key = Keypad_GetKey();

        if (key >= '0' && key <= '9')
        {
            entered_password[index] = key;
            index++;
        }
    }

    entered_password[PASSWORD_LENGTH] = '\0';

    for (index = 0; index < PASSWORD_LENGTH; index++)
    {
        if (entered_password[index] != correct_password[index])
        {
            return 0;
        }
    }

    return 1;
}


void Lockout(void)
{
    /*
     * Red LED ON
     * Buzzer ON
     */
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_SET);

    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_SET);

    /*
     * Lock system for 10 seconds
     */
    HAL_Delay(LOCKOUT_TIME);

    /*
     * Turn everything OFF
     */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);
}


int main(void)
{
    uint8_t attempts;
    uint8_t password_correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Green LED OFF */
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);

    /* Red LED OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);

    /* Buzzer OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);

    attempts = 0;

    while (1)
    {
        /*
         * Wait for person detection.
         * IR sensor is active LOW.
         */
        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
            == GPIO_PIN_RESET)
        {
            /*
             * Person detected
             */
            HAL_GPIO_WritePin(GPIOA,
                              GPIO_PIN_6,
                              GPIO_PIN_SET);

            HAL_Delay(500);

            /*
             * Reset attempts for this access session
             */
            attempts = 0;

            while (attempts < MAX_ATTEMPTS)
            {
                /*
                 * Ask for PIN
                 */
                password_correct = CheckPassword();

                if (password_correct)
                {
                    /*
                     * ACCESS GRANTED
                     */

                    /* Green LED ON */
                    HAL_GPIO_WritePin(GPIOA,
                                      GPIO_PIN_6,
                                      GPIO_PIN_SET);

                    /* Red LED OFF */
                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_5,
                                      GPIO_PIN_RESET);

                    /* Buzzer OFF */
                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_10,
                                      GPIO_PIN_RESET);

                    /* Keep access granted for 3 seconds */
                    HAL_Delay(3000);

                    /* Green LED OFF */
                    HAL_GPIO_WritePin(GPIOA,
                                      GPIO_PIN_6,
                                      GPIO_PIN_RESET);

                    break;
                }
                else
                {
                    /*
                     * WRONG PIN
                     */
                    attempts++;

                    /* Green LED OFF */
                    HAL_GPIO_WritePin(GPIOA,
                                      GPIO_PIN_6,
                                      GPIO_PIN_RESET);

                    /* Red LED ON */
                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_5,
                                      GPIO_PIN_SET);

                    /* Buzzer ON */
                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_10,
                                      GPIO_PIN_SET);

                    /* Warning for 1 second */
                    HAL_Delay(1000);

                    /* Turn warning OFF */
                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_5,
                                      GPIO_PIN_RESET);

                    HAL_GPIO_WritePin(GPIOB,
                                      GPIO_PIN_10,
                                      GPIO_PIN_RESET);

                    /*
                     * If 3 wrong attempts,
                     * lock the system.
                     */
                    if (attempts >= MAX_ATTEMPTS)
                    {
                        Lockout();
                    }
                    else
                    {
                        /*
                         * Allow another attempt
                         */
                        HAL_Delay(500);
                    }
                }
            }

            /*
             * Wait before accepting another
             * IR detection.
             */
            HAL_Delay(500);
        }

        HAL_Delay(50);
    }
}
