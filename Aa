#include "main.h"

#define PASSWORD_LENGTH 4

const char correct_password[] = "1234";

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t rows[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t cols[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* All rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          rows[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, cols[col]) == GPIO_PIN_RESET)
            {
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, cols[col]) == GPIO_PIN_RESET)
                {
                    while (HAL_GPIO_ReadPin(GPIOC, cols[col]) == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


int main(void)
{
    char entered_password[5];
    char key;
    uint8_t index = 0;
    uint8_t correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Green LED OFF */
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);

    /* Buzzer OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);

    while (1)
    {
        key = Keypad_GetKey();

        if (key == 0)
        {
            continue;
        }

        /* Number */
        if (key >= '0' && key <= '9')
        {
            if (index < PASSWORD_LENGTH)
            {
                entered_password[index] = key;
                index++;
            }
        }

        /* Clear */
        else if (key == '*')
        {
            index = 0;

            HAL_GPIO_WritePin(GPIOA,
                              GPIO_PIN_6,
                              GPIO_PIN_RESET);

            HAL_GPIO_WritePin(GPIOB,
                              GPIO_PIN_10,
                              GPIO_PIN_RESET);
        }

        /* Submit */
        else if (key == '#')
        {
            correct = 1;

            if (index != PASSWORD_LENGTH)
            {
                correct = 0;
            }
            else
            {
                for (uint8_t i = 0; i < PASSWORD_LENGTH; i++)
                {
                    if (entered_password[i] != correct_password[i])
                    {
                        correct = 0;
                        break;
                    }
                }
            }

            if (correct)
            {
                /* Correct PIN */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_SET);

                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_SET);
            }
            else
            {
                /* Wrong PIN */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_RESET);

                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_RESET);
            }

            index = 0;
        }
    }
}
