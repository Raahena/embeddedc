
#include "main.h"

#define PASSWORD_LENGTH 4
#define MAX_ATTEMPTS 3
#define LOCKOUT_TIME 10000

const char correct_password[PASSWORD_LENGTH + 1] = "1234";


/* ================= KEYPAD ================= */

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* All rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait for key release */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


/* ================= PASSWORD ================= */

uint8_t CheckPassword(void)
{
    char entered_password[PASSWORD_LENGTH + 1];
    char key;
    uint8_t index = 0;

    while (1)
    {
        key = Keypad_GetKey();

        if (key == 0)
        {
            continue;
        }

        /* Number key */
        if (key >= '0' && key <= '9')
        {
            if (index < PASSWORD_LENGTH)
            {
                entered_password[index] = key;
                index++;
            }
        }

        /* * = Clear */
        else if (key == '*')
        {
            index = 0;
        }

        /* # = Submit */
        else if (key == '#')
        {
            if (index != PASSWORD_LENGTH)
            {
                return 0;
            }

            entered_password[index] = '\0';

            for (index = 0; index < PASSWORD_LENGTH; index++)
            {
                if (entered_password[index]
                    != correct_password[index])
                {
                    return 0;
                }
            }

            return 1;
        }
    }
}


/* ================= LED / BUZZER FUNCTIONS ================= */

void White_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_SET);
}

void White_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_RESET);
}


void Green_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_SET);
}

void Green_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);
}


void Red_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_SET);
}

void Red_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);
}


void Buzzer_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_SET);
}

void Buzzer_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);
}


/* ================= ALL OFF ================= */

void All_Off(void)
{
    White_Off();
    Green_Off();
    Red_Off();
    Buzzer_Off();
}


/* ================= LOCKOUT ================= */

void Lockout(void)
{
    /*
     * 3 wrong attempts.
     *
     * White OFF
     * Green OFF
     * Red ON
     * Buzzer ON
     */

    White_Off();
    Green_Off();
    Red_On();
    Buzzer_On();

    /* Lock system for 10 seconds */
    HAL_Delay(LOCKOUT_TIME);

    /* Return to normal */
    Red_Off();
    Buzzer_Off();
}


/* ================= MAIN ================= */

int main(void)
{
    uint8_t attempts;
    uint8_t password_correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Initial state */
    All_Off();

    while (1)
    {
        /*
         * IR sensor is ACTIVE LOW.
         *
         * PB0 = LOW
         * means person detected.
         */

        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
            == GPIO_PIN_RESET)
        {
            /*
             * Person detected.
             *
             * White LED = system active
             * Green = OFF
             * Red = OFF
             * Buzzer = OFF
             */

            White_On();
            Green_Off();
            Red_Off();
            Buzzer_Off();

            HAL_Delay(500);

            attempts = 0;

            /* ================= PASSWORD LOOP ================= */

            while (attempts < MAX_ATTEMPTS)
            {
                /*
                 * Wait for PIN.
                 */
                password_correct = CheckPassword();

                /* ================= CORRECT ================= */

                if (password_correct)
                {
                    /*
                     * Access granted.
                     *
                     * White OFF
                     * Green ON
                     * Red OFF
                     * Buzzer OFF
                     */

                    White_Off();
                    Green_On();
                    Red_Off();
                    Buzzer_Off();

                    /*
                     * Keep green ON
                     * for 3 seconds.
                     */

                    HAL_Delay(3000);

                    Green_Off();

                    break;
                }

                /* ================= WRONG ================= */

                else
                {
                    attempts++;

                    /*
                     * Access denied.
                     *
                     * White OFF
                     * Green OFF
                     * Red ON
                     * Buzzer ON
                     */

                    White_Off();
                    Green_Off();
                    Red_On();
                    Buzzer_On();

                    /*
                     * Warning for 1 second.
                     */

                    HAL_Delay(1000);

                    Red_Off();
                    Buzzer_Off();

                    /*
                     * 3 wrong attempts
                     */

                    if (attempts >= MAX_ATTEMPTS)
                    {
                        Lockout();
                    }
                    else
                    {
                        /*
                         * Turn white LED back ON
                         * for next attempt.
                         */

                        White_On();

                        HAL_Delay(500);
                    }
                }
            }

            /*
             * Wait until the person leaves
             * the IR sensor.
             *
             * This prevents the same detection
             * from immediately starting again.
             */

            while (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
                   == GPIO_PIN_RESET)
            {
                HAL_Delay(50);
            }

            All_Off();

            HAL_Delay(500);
        }

        HAL_Delay(50);
    }
}
