char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    const uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    const uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* Set all rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 |
                          GPIO_PIN_1 |
                          GPIO_PIN_2 |
                          GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Set current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        /* Check columns */
        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait for key release */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                        HAL_Delay(1);
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}
int main(void)
{
    char key;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    All_Off();

    while (1)
    {
        key = Keypad_GetKey();

        if (key != 0)
        {
            /* Every detected key: white ON */
            White_On();

            /*
             * GREEN = digits 1,2,3,4
             */
            if (key == '1' ||
                key == '2' ||
                key == '3' ||
                key == '4')
            {
                Green_On();
            }

            /*
             * RED = #
             */
            if (key == '#')
            {
                Red_On();
            }

            /*
             * BUZZER = *
             */
            if (key == '*')
            {
                Buzzer_On();
            }

            HAL_Delay(500);

            All_Off();
        }
    }
}
