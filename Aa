#include "main.h"


/* ================= KEYPAD ================= */

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    const uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    const uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* All rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 |
                          GPIO_PIN_1 |
                          GPIO_PIN_2 |
                          GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait for release */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                        HAL_Delay(1);
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


/* ================= LED FUNCTIONS ================= */

/* White LED = PA1 */
void White_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_SET);
}

void White_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_RESET);
}


/* Red LED = PA6 */
void Red_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_SET);
}

void Red_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);
}


/* Green LED = PB5 */
void Green_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_SET);
}

void Green_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);
}


/* Buzzer = PB10 */
void Buzzer_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_SET);
}

void Buzzer_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);
}


/* Turn everything OFF */
void All_Off(void)
{
    White_Off();
    Red_Off();
    Green_Off();
    Buzzer_Off();
}


/* ================= MAIN ================= */

int main(void)
{
    char key;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Start with everything OFF */
    All_Off();

    while (1)
    {
        key = Keypad_GetKey();

        if (key != 0)
        {
            /* Every valid key turns WHITE ON */
            White_On();

            /*
             * 1,2,3,4
             * WHITE + GREEN
             */
            if (key == '1' ||
                key == '2' ||
                key == '3' ||
                key == '4')
            {
                Green_On();
            }

            /*
             * #
             * WHITE + RED
             */
            else if (key == '#')
            {
                Red_On();
            }

            /*
             * *
             * WHITE + BUZZER
             */
            else if (key == '*')
            {
                Buzzer_On();
            }

            /*
             * Any other key
             * WHITE only
             */
            else
            {
                /* Nothing else */
            }

            HAL_Delay(500);

            /* Turn everything OFF */
            All_Off();
        }
    }
}
