#include "main.h"

#define PASSWORD_LENGTH 4
#define MAX_ATTEMPTS 3
#define LOCKOUT_TIME 10000

const char correct_password[PASSWORD_LENGTH + 1] = "1234";


/* ================= KEYPAD ================= */

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* All rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


/* ================= PASSWORD ================= */

uint8_t CheckPassword(void)
{
    char entered_password[PASSWORD_LENGTH + 1];
    char key;
    uint8_t index = 0;

    while (1)
    {
        key = Keypad_GetKey();

        if (key == 0)
            continue;

        /* Number */
        if (key >= '0' && key <= '9')
        {
            if (index < PASSWORD_LENGTH)
            {
                entered_password[index] = key;
                index++;
            }
        }

        /* Clear */
        else if (key == '*')
        {
            index = 0;
        }

        /* Submit */
        else if (key == '#')
        {
            if (index != PASSWORD_LENGTH)
            {
                return 0;
            }

            entered_password[index] = '\0';

            for (index = 0; index < PASSWORD_LENGTH; index++)
            {
                if (entered_password[index]
                    != correct_password[index])
                {
                    return 0;
                }
            }

            return 1;
        }
    }
}


/* ================= WHITE LED ================= */

void White_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_SET);
}

void White_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_1,
                      GPIO_PIN_RESET);
}


/* ================= GREEN LED ================= */

void Green_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_SET);
}

void Green_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);
}


/* ================= RED LED ================= */

void Red_On(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_SET);
}

void Red_Off(void)
{
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);
}


/* ================= BUZZER ================= */

void Buzzer_On(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_SET);
}

void Buzzer_Off(void)
{
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);
}


/* ================= ALL OFF ================= */

void All_Off(void)
{
    White_Off();
    Green_Off();
    Red_Off();
    Buzzer_Off();
}


/* ================= LOCKOUT ================= */

void Lockout(void)
{
    White_Off();
    Green_Off();

    /* Red ON */
    Red_On();

    /* Buzzer ON */
    Buzzer_On();

    /* 10 second lockout */
    HAL_Delay(LOCKOUT_TIME);

    Red_Off();
    Buzzer_Off();
}


/* ================= MAIN ================= */

int main(void)
{
    uint8_t attempts;
    uint8_t password_correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Everything OFF initially */
    All_Off();

    while (1)
    {
        /*
         * IR sensor ACTIVE LOW
         *
         * PB0 = LOW
         * Person detected
         */

        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
            == GPIO_PIN_RESET)
        {
            /*
             * PERSON DETECTED
             *
             * White ON
             * Green OFF
             * Red OFF
             * Buzzer OFF
             */

            White_On();
            Green_Off();
            Red_Off();
            Buzzer_Off();

            HAL_Delay(500);

            attempts = 0;

            /* ================= ATTEMPTS ================= */

            while (attempts < MAX_ATTEMPTS)
            {
                password_correct = CheckPassword();

                /* ========== CORRECT PASSWORD ========== */

                if (password_correct)
                {
                    /*
                     * ACCESS GRANTED
                     *
                     * White OFF
                     * Green ON
                     * Red OFF
                     * Buzzer OFF
                     */

                    White_Off();
                    Red_Off();
                    Buzzer_Off();

                    Green_On();

                    /* Access for 3 seconds */
                    HAL_Delay(3000);

                    Green_Off();

                    break;
                }

                /* ========== WRONG PASSWORD ========== */

                else
                {
                    attempts++;

                    /*
                     * ACCESS DENIED
                     *
                     * White OFF
                     * Green OFF
                     * Red ON
                     * Buzzer ON
                     */

                    White_Off();
                    Green_Off();

                    Red_On();
                    Buzzer_On();

                    /* Warning for 1 second */
                    HAL_Delay(1000);

                    Red_Off();
                    Buzzer_Off();

                    /*
                     * Three wrong attempts
                     */

                    if (attempts >= MAX_ATTEMPTS)
                    {
                        Lockout();
                    }
                    else
                    {
                        /*
                         * Ready for another PIN
                         *
                         * White ON
                         */

                        White_On();

                        HAL_Delay(500);
                    }
                }
            }

            /*
             * Wait until person leaves
             * the IR sensor.
             */

            while (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
                   == GPIO_PIN_RESET)
            {
                HAL_Delay(50);
            }

            /* Back to idle */
            All_Off();

            HAL_Delay(500);
        }

        HAL_Delay(50);
    }
}
