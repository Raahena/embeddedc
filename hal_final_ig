#include "main.h"
#include <string.h>

#define PASSWORD_LENGTH 4

const char correct_password[PASSWORD_LENGTH + 1] = "1234";


char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* Set all rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Set current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait for key release */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


int main(void)
{
    char entered_password[PASSWORD_LENGTH + 1];
    char key;

    uint8_t index;
    uint8_t correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Green LED OFF */
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);

    /* Red LED OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);

    /* Buzzer OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);

    while (1)
    {
        /*
         * Wait for IR detection.
         *
         * IR sensor is active LOW.
         */
        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
            == GPIO_PIN_RESET)
        {
            /*
             * Person detected.
             * Green LED indicates that
             * the system is ready for PIN.
             */
            HAL_GPIO_WritePin(GPIOA,
                              GPIO_PIN_6,
                              GPIO_PIN_SET);

            HAL_Delay(500);

            /*
             * Read 4-digit PIN
             */
            index = 0;

            while (index < PASSWORD_LENGTH)
            {
                key = Keypad_GetKey();

                if (key >= '0' && key <= '9')
                {
                    entered_password[index] = key;
                    index++;
                }
            }

            entered_password[PASSWORD_LENGTH] = '\0';

            /*
             * Compare entered PIN
             * with correct PIN.
             */
            correct = 1;

            for (index = 0; index < PASSWORD_LENGTH; index++)
            {
                if (entered_password[index]
                    != correct_password[index])
                {
                    correct = 0;
                    break;
                }
            }

            /*
             * CORRECT PIN
             */
            if (correct)
            {
                /* Green LED ON */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_SET);

                /* Red LED OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_RESET);

                /* Buzzer OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_RESET);

                /* Access granted */
                HAL_Delay(3000);

                /* Green LED OFF */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_RESET);
            }

            /*
             * WRONG PIN
             */
            else
            {
                /* Green LED OFF */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_RESET);

                /* Red LED ON */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_SET);

                /* Buzzer ON */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_SET);

                /* Access denied */
                HAL_Delay(1000);

                /* Red LED OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_RESET);

                /* Buzzer OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_RESET);
            }

            /*
             * Small delay before another
             * detection can be processed.
             */
            HAL_Delay(500);
        }

        HAL_Delay(50);
    }
}
