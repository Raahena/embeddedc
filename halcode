#include "main.h"

char Keypad_GetKey(void)
{
    const char keymap[4][4] =
    {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    uint16_t row_pins[4] =
    {
        GPIO_PIN_0,
        GPIO_PIN_1,
        GPIO_PIN_2,
        GPIO_PIN_3
    };

    uint16_t col_pins[4] =
    {
        GPIO_PIN_4,
        GPIO_PIN_5,
        GPIO_PIN_6,
        GPIO_PIN_7
    };

    for (int row = 0; row < 4; row++)
    {
        /* Set all rows HIGH */
        HAL_GPIO_WritePin(GPIOC,
                          GPIO_PIN_0 | GPIO_PIN_1 |
                          GPIO_PIN_2 | GPIO_PIN_3,
                          GPIO_PIN_SET);

        /* Set current row LOW */
        HAL_GPIO_WritePin(GPIOC,
                          row_pins[row],
                          GPIO_PIN_RESET);

        HAL_Delay(1);

        for (int col = 0; col < 4; col++)
        {
            if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                == GPIO_PIN_RESET)
            {
                /* Debounce */
                HAL_Delay(20);

                if (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                    == GPIO_PIN_RESET)
                {
                    /* Wait until key is released */
                    while (HAL_GPIO_ReadPin(GPIOC, col_pins[col])
                           == GPIO_PIN_RESET)
                    {
                    }

                    return keymap[row][col];
                }
            }
        }
    }

    return 0;
}


int main(void)
{
    char key;
    char password[5];

    uint8_t index;
    uint8_t correct;

    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    /* Green/external LED OFF */
    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_6,
                      GPIO_PIN_RESET);

    /* Red LED OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_5,
                      GPIO_PIN_RESET);

    /* Buzzer OFF */
    HAL_GPIO_WritePin(GPIOB,
                      GPIO_PIN_10,
                      GPIO_PIN_RESET);

    while (1)
    {
        /*
         * Wait for IR sensor detection.
         * IR sensor is active LOW.
         */
        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0)
            == GPIO_PIN_RESET)
        {
            /*
             * Person detected
             */
            HAL_GPIO_WritePin(GPIOA,
                              GPIO_PIN_6,
                              GPIO_PIN_SET);

            HAL_Delay(500);

            /*
             * Get 4 digit password
             */
            index = 0;

            while (index < 4)
            {
                key = Keypad_GetKey();

                if (key >= '0' && key <= '9')
                {
                    password[index] = key;
                    index++;
                }
            }

            password[4] = '\0';

            /*
             * Check password
             * Correct password = 1234
             */
            correct = 1;

            if (password[0] != '1')
            {
                correct = 0;
            }

            if (password[1] != '2')
            {
                correct = 0;
            }

            if (password[2] != '3')
            {
                correct = 0;
            }

            if (password[3] != '4')
            {
                correct = 0;
            }

            /*
             * Correct PIN
             */
            if (correct)
            {
                /* Green LED ON */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_SET);

                /* Red LED OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_RESET);

                /* Buzzer OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_RESET);

                /* Access granted indication */
                HAL_Delay(3000);

                /* Green LED OFF */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_RESET);
            }

            /*
             * Wrong PIN
             */
            else
            {
                /* Green LED OFF */
                HAL_GPIO_WritePin(GPIOA,
                                  GPIO_PIN_6,
                                  GPIO_PIN_RESET);

                /* Red LED ON */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_SET);

                /* Buzzer ON */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_SET);

                /* Wrong PIN indication */
                HAL_Delay(1000);

                /* Red LED OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_5,
                                  GPIO_PIN_RESET);

                /* Buzzer OFF */
                HAL_GPIO_WritePin(GPIOB,
                                  GPIO_PIN_10,
                                  GPIO_PIN_RESET);
            }

            /*
             * Small delay before another detection
             */
            HAL_Delay(500);
        }

        HAL_Delay(50);
    }
}
